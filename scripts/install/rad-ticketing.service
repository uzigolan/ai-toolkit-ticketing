[Unit]
Description=RAD AI Ticketing Center
Documentation=file:///home/rocky/ai-toolkit-ticketing/README.md
After=network.target

[Service]
Type=simple
User=rocky
Group=rocky

# Everything runs out of the git clone: the interpreter is the repo's own
# .venv, never the OS python, so `git pull && systemctl restart` is the whole
# update procedure. config.ini is read relative to this directory.
WorkingDirectory=/home/rocky/ai-toolkit-ticketing

# Secrets and file locations; ports and LDAP live in config.ini.
# The leading '-' lets the unit start before the file exists.
EnvironmentFile=-/home/rocky/ai-toolkit-ticketing/.env

# Schema first, then serve. A migration failure stops the unit rather than
# leaving the app running against a half-built database.
ExecStartPre=/home/rocky/ai-toolkit-ticketing/.venv/bin/python migrate_db.py
ExecStart=/home/rocky/ai-toolkit-ticketing/.venv/bin/python serve.py

Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rad-ticketing

# Harden the process. ProtectHome stays off because the install lives under
# /home; the app can still only write inside its own directory.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=no
ReadWritePaths=/home/rocky/ai-toolkit-ticketing
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
